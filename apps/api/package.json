{
  "name": "@vibe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@vibe/source --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "dev:worker": "tsx watch --conditions=@vibe/source --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --conditions=@vibe/source --env-file-if-exists=.env scripts/seed.ts",
    "db:sync-indexes": "tsx --conditions=@vibe/source --env-file-if-exists=.env scripts/sync-indexes.ts",
    "bench:feed": "tsx --conditions=@vibe/source --env-file-if-exists=.env scripts/bench-feed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@vibe/shared": "0.1.0",
    "bullmq": "^6.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "jose": "^6.2.15",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
