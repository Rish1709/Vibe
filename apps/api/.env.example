# Copy to apps/api/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Single-node replica set from docker-compose.yml (a replica set is required for transactions).
# directConnection=true stops the driver from following the member's advertised hostname.
MONGODB_URI=mongodb://localhost:27017/vibe?directConnection=true
MONGODB_MAX_POOL_SIZE=20

REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (0 when hitting the API directly).
TRUST_PROXY=0

REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000

# --- Clerk (Dashboard -> Configure -> API keys) ---
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: PEM public key ("Show JWT public key" -> PEM) for networkless verification.
# Put it on one line with \n for newlines. Without it, Clerk's JWKS is fetched and cached.
CLERK_JWT_KEY=
# Optional: defaults to CORS_ORIGINS.
CLERK_AUTHORIZED_PARTIES=
# Dashboard -> Configure -> Webhooks -> add endpoint .../api/v1/webhooks/clerk (user.* events).
CLERK_WEBHOOK_SIGNING_SECRET=
