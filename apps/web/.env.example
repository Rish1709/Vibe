# Copy to apps/web/.env.local. Vite exposes only VITE_* variables to the browser,
# so never put secrets in this file.

# Leave empty in development: requests go through the Vite proxy to http://localhost:4000.
VITE_API_URL=

# Clerk Dashboard -> Configure -> API keys -> Publishable key. Safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=
