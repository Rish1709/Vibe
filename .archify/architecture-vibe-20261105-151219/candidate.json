  "cards": [
    {
      "dot": "emerald",
      "title": "Hybrid feed",
      "items": [
        "Post → job → worker pushes the id onto each follower's Redis timeline",
        "Authors with huge followings skip the push; merged in at read time",
        "Redis is a cache only: a lost timeline is rebuilt from MongoDB"
      ]
    },
    {
      "dot": "cyan",
      "title": "Realtime across instances",
      "items": [
        "Each socket joins user:<id>; any instance or the worker reaches it via Redis pub/sub",
        "Sends go over REST (idempotent clientId); sockets only push"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Every request verifies a Clerk JWT; per-IP and per-user rate limits in Redis",
        "File bytes never touch the API: signed tickets, verified after upload"
      ]
    },
    {
      "dot": "amber",
      "title": "Measured",
      "items": [
        "Every query served by an index in order (profiler test)",
        "Post page: 8 MongoDB queries + 3 Redis commands, at any page size"
      ]
    }
  ]
