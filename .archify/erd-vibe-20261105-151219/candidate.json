  "cards": [
    {
      "dot": "emerald",
      "title": "Edges are documents",
      "items": [
        "A follow, like, bookmark or block is one small document",
        "A unique index on the pair stops duplicates under races",
        "No unbounded arrays inside users"
      ]
    },
    {
      "dot": "cyan",
      "title": "Denormalized on purpose",
      "items": [
        "counts: followers/following/posts on users, likes/comments/reposts on posts, $inc + daily reconcile",
        "Media embedded in posts and stories (read together, at most 4)",
        "conversations.members holds unread count and lastReadAt per participant"
      ]
    },
    {
      "dot": "rose",
      "title": "Deletes and expiry",
      "items": [
        "Soft delete (deletedAt) where others point; a background cascade purges",
        "Stories expire in queries (expiresAt > now); TTL indexes collect garbage",
        "media.status: pending > ready > attached, or released for cleanup"
      ]
    },
    {
      "dot": "amber",
      "title": "Self-references",
      "items": [
        "posts.sharedPostId points at another post: a quote or a plain repost",
        "comments.parentId points at a top-level comment: replies are one level deep"
      ]
    }
  ]
}