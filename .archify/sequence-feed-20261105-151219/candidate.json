  "cards": [
    {
      "dot": "emerald",
      "title": "Why hybrid",
      "items": [
        "Pure pull: every feed read queries all followees' posts",
        "Pure push: one celebrity post means millions of writes",
        "Push for most authors, pull for the few with huge followings"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cheap reads",
      "items": [
        "A cached feed page: 9 MongoDB queries + 13 Redis commands (load test)",
        "Timelines expire after 7 days unused, so memory tracks active readers"
      ]
    },
    {
      "dot": "rose",
      "title": "Correct when caches lie",
      "items": [
        "Follow-graph changes drop the timeline (versioned), next read rebuilds",
        "Redis is never the only copy: every path falls back to MongoDB"
      ]
    }
